{
  "name": "mra/server",
  "description": "Mutual Render Attestation — consent server",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "ext-mbstring": "*",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": { "psr-4": { "Mra\\": "src/" } },
  "autoload-dev": { "psr-4": { "Mra\\Tests\\": "tests/" } },
  "scripts": {
    "lint": "phpcs",
    "test": "phpunit --do-not-fail-on-empty-test-suite"
  },
  "config": { "sort-packages": true, "platform-check": true }
}
