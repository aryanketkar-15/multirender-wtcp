{
  "name": "mra-attestor",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && node scripts/build.cjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest -c jest.ci.cjs --changedSince=origin/main --passWithNoTests",
    "serve": "node scripts/serve.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "esbuild": "0.28.2",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
